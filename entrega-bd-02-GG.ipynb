  {
   "cell_type": "code",
   "execution_count": null,
   "id": "78",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%sql zoo\n",
    "EXPLAIN ANALYSE\n",
    "SELECT id_zona, id_recinto, rentabilidade\n",
    "FROM recinto r1\n",
    "WHERE r1.rentabilidade = (\n",
    "    SELECT MAX(rentabilidade)\n",
